# Makefile.standalone -- proves the LIBRARIES-coastline header swap
# (src/README.md, src/icytower/GENERATED.md,
# carrier/gen/LIB_BINDINGS_NOTES.md "Standalone build swap") by compiling
# the UNCHANGED clean-source .c files under src/icytower/ into a static
# library, -DICYTOWER_UPSTREAM_ALLEGRO, against the REAL upstream Allegro
# 4.4.3.1 headers/libs built in third_party/ (third_party/BUILD.md) instead
# of the port's own allegro_types.h/allegro_api.h stand-ins, then links a
# tiny smoke test against it.
#
# Toolchain: MSYS2 MINGW32 (32-bit i686-w64-mingw32 gcc, native -- not a
# multilib compiler, so -m32 is accepted but a no-op; kept because it is
# this task's specified invocation and is harmless).
#
#   MSYSTEM=MINGW32 C:\msys64\usr\bin\bash.exe -lc \
#     "cd /d/Games/DOS/dos_recosystem/icytower_forged && \
#      mingw32-make -f src/build/Makefile.standalone"
#
# Targets:
#   all (default)     libicytower.a + standalone_smoke.exe, then runs the smoke test
#   libicytower.a      the 8 promoted-function .c files + state.c, upstream world
#   standalone_smoke.exe  links the above against liballeg.a/liblogg.a
#   run                 runs standalone_smoke.exe
#   clean

REPO_ROOT := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/../..)
SRC       := $(REPO_ROOT)/src/icytower
BUILDDIR  := $(REPO_ROOT)/src/build
OBJDIR    := $(BUILDDIR)/obj

ALLEGRO_SRC   := $(REPO_ROOT)/third_party/allegro-4.4.3.1
ALLEGRO_BUILD := $(REPO_ROOT)/third_party/build-allegro-4.4.3.1

CC      := gcc
CFLAGS  := -m32 -mfpmath=387 -DICYTOWER_UPSTREAM_ALLEGRO -DALLEGRO_STATICLINK -Wall \
           -I$(ALLEGRO_SRC)/include -I$(ALLEGRO_BUILD)/include \
           -I$(ALLEGRO_SRC)/addons/logg -I$(SRC)
AR      := ar

# Every promoted .c file that needs no asset seam, updated through batch 7
# (2026-09-07 -- play_jump_sound.c/handle_player_collision_original.c added;
# both call play_sound(), not yet promoted/defined anywhere in src/, but
# this is safe: SOURCES only feeds libicytower.a, a static archive, and the
# final $(SMOKE_EXE) link only pulls in an archive member actually
# referenced by standalone_smoke.c or something it references -- neither
# new file is, so play_sound() never needs to resolve here, exactly as it
# already didn't for is_solid.c/etc's own not-yet-promoted callees).
# Excluded on purpose: game_types_check.c ("game_types_check.c is out of
# scope here": its sizeof/offsetof assertions check the DWARF-recovered
# ADDRESS-BACKED layout of Allegro's internal structs, e.g.
# LZSS_UNPACK_DATA/_al_normal_packfile_details, which upstream's public
# <allegro.h> does not even expose -- that check only makes sense against
# src/icytower's own stand-in, never against upstream); draw_buffer.c/
# assets_standalone.c/start_reward.c (the asset-seam files -- start_reward.c
# calls asset_bitmap(), out of scope for this basic smoke test the same way
# draw_buffer.c already was; both are compile-checked separately, see
# src/icytower/ASSETS.md and PROMOTIONS.md batch 7).
SOURCES := add_combo.c add_jump_sequence.c control.c is_solid.c jump_player.c \
           line_intersect.c map.c main_state.c new_rand.c ok_to_play.c \
           particle.c reset_player.c scroller.c timer.c update_frame.c \
           update_player.c play_jump_sound.c handle_player_collision_original.c \
           collision.c state.c
OBJECTS := $(patsubst %.c,$(OBJDIR)/%.o,$(SOURCES))

LIB       := $(BUILDDIR)/libicytower.a
SMOKE_SRC := $(BUILDDIR)/standalone_smoke.c
SMOKE_EXE := $(BUILDDIR)/standalone_smoke.exe

LIBDIR := $(ALLEGRO_BUILD)/lib
# liballeg.a + liblogg.a (static, this project's own build); libpng not
# needed (load_png is not in the lib_boundary.json allow-list -- see
# carrier/gen/LIB_BINDINGS_NOTES.md "Constants"/"Allow-list source" --
# allegro_api.h's ICYTOWER_UPSTREAM_ALLEGRO branch only pulls in <logg.h>).
# libvorbis/libogg/libz are logg's own dependencies (DLL import libs, per
# third_party/BUILD.md SS3); the DirectX/Win32 libs are liballeg.a's own,
# same set third_party/smoke/smoke.c links against.
LIBS := -L$(LIBDIR) -llogg -lalleg \
        -lvorbisfile -lvorbis -logg -lz \
        -ldinput -lddraw -ldxguid -lwinmm -ldsound -lole32 -lcomdlg32 -lgdi32 -luser32 -lkernel32 \
        -lmingw32

# asset_oracle: src/icytower/ASSETS.md "Extraction and the asset oracle" --
# links assets_standalone.c (excluded from SOURCES/libicytower.a above; the
# oracle needs it standalone, not as part of the game-logic archive) plus
# this directory's own asset_oracle.c + sha256.h against the same static
# Allegro, so it can call the real load_datafile()-backed asset_bitmap()/
# asset_sample()/asset_font()/asset_palette()/asset_object() for every id.
ORACLE_EXE := $(BUILDDIR)/asset_oracle.exe
ORACLE_OBJS := $(OBJDIR)/asset_oracle.o $(OBJDIR)/assets_standalone.o $(OBJDIR)/logg_load_memory_shim.o

.PHONY: all clean run asset_oracle run-asset-oracle
all: $(SMOKE_EXE)

$(OBJDIR):
	mkdir -p "$(OBJDIR)"

$(OBJDIR)/%.o: $(SRC)/%.c | $(OBJDIR)
	$(CC) $(CFLAGS) -c "$<" -o "$@"

$(LIB): $(OBJECTS)
	$(AR) rcs "$(LIB)" $(OBJECTS)

$(OBJDIR)/standalone_smoke.o: $(SMOKE_SRC) | $(OBJDIR)
	$(CC) $(CFLAGS) -c "$<" -o "$@"

$(SMOKE_EXE): $(OBJDIR)/standalone_smoke.o $(LIB)
	$(CC) -m32 "$(OBJDIR)/standalone_smoke.o" "$(LIB)" -o "$(SMOKE_EXE)" $(LIBS)

$(OBJDIR)/asset_oracle.o: $(BUILDDIR)/asset_oracle.c $(BUILDDIR)/sha256.h | $(OBJDIR)
	$(CC) $(CFLAGS) -c "$<" -o "$@"

$(OBJDIR)/logg_load_memory_shim.o: $(BUILDDIR)/logg_load_memory_shim.c | $(OBJDIR)
	$(CC) $(CFLAGS) -c "$<" -o "$@"

# assets_standalone.c is GENERATED (carrier/gen/gen_assets.py) and this task
# does not own that generator; force-including the shim's prototype ahead of
# its compile (only for THIS target, not the generic pattern rule other
# game-logic files use) supplies logg_load_memory's declaration without
# hand-editing the generated file. See logg_load_memory_shim.h.
$(OBJDIR)/assets_standalone.o: $(SRC)/assets_standalone.c $(BUILDDIR)/logg_load_memory_shim.h | $(OBJDIR)
	$(CC) $(CFLAGS) -include "$(BUILDDIR)/logg_load_memory_shim.h" -c "$<" -o "$@"

asset_oracle: $(ORACLE_EXE)

$(ORACLE_EXE): $(ORACLE_OBJS)
	$(CC) -m32 $(ORACLE_OBJS) -o "$(ORACLE_EXE)" $(LIBS)

run: $(SMOKE_EXE)
	cd "$(BUILDDIR)" && ./standalone_smoke.exe

# asset_oracle.exe opens its datafiles by the SAME relative paths the real
# game does ("data/data.dat", "characters/<name>/<name>.dat" --
# src/icytower/assets_table.inc), so it must run with the gitignored
# assets/ directory (a local copy of the game) as its working directory.
run-asset-oracle: $(ORACLE_EXE)
	cd "$(REPO_ROOT)/assets" && "$(ORACLE_EXE)"

clean:
	rm -rf "$(OBJDIR)" "$(LIB)" "$(SMOKE_EXE)" "$(ORACLE_EXE)"
