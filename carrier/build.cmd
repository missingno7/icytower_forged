@echo off
rem build.cmd - one command builds carrier.exe (x86, debug: /Zi /Od).
rem Regenerate gen\*.inc / gen\import_stubs.cpp first if imports.json changed:
rem   python gen\gen_imports.py ..\imports.json gen
rem
rem Milestones 11-12 (win32_pilot.md SS3): the LIFTED forms (lift\lifted\*.c,
rem generated by lift\pf_lift.py) and the NATIVE forms (native\*.c) are
rem compiled straight into carrier.exe as C, and bound at their original
rem addresses at run time by src\bind.cpp's 5-byte entry patch. They need
rem gen\ (it_types.h/it_funcs.h/it_globals.h) and lift\lifted\ (pf_rt.h) on
rem the include path; PF_MEM() is the identity here, because the carrier maps
rem the original image at its real base.
setlocal
cd /d "%~dp0"

call "C:\Program Files\Microsoft Visual Studio\2022\Community\VC\Auxiliary\Build\vcvars32.bat"
if errorlevel 1 (
  echo FAILED: could not initialize MSVC x86 build environment
  exit /b 1
)

if not exist obj mkdir obj

cl /nologo /Zi /Od /EHsc /W3 /D_CRT_SECURE_NO_WARNINGS ^
  /I gen /I lift\lifted ^
  src\main.cpp src\pe_image.cpp src\imports.cpp src\trace.cpp src\wrappers.cpp src\symbols.cpp src\det.cpp src\bind.cpp ^
  gen\import_stubs.cpp ^
  lift\lifted\lifted_update_frame.c lift\lifted\lifted_is_solid.c lift\lifted\lifted_jump_player.c ^
  native\native_update_frame.c native\native_is_solid.c ^
  /Fe:carrier.exe /Fo:obj\ ^
  /link /DYNAMICBASE:NO /FIXED /BASE:0x10000000 /LARGEADDRESSAWARE:NO /SUBSYSTEM:CONSOLE /DEBUG /MAP:obj\carrier.map kernel32.lib user32.lib psapi.lib

if errorlevel 1 (
  echo FAILED: build errors above
  exit /b 1
)
echo OK: carrier\carrier.exe built
endlocal
