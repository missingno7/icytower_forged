# all_rows_src.bindfile -- GENERATED-BY-HAND-FROM carrier/gen/bind_table.inc (divergence 010).
#
# WHY THIS FILE EXISTS, and why all_src.bindfile could not be used for the
# divergence-010 A/B: carrier/gen/pf_bindings_src.h leaves every PROMOTED
# name undefined ("excluded (compiled natively, name kept free)"), so a
# src/icytower/*.c file compiled into the carrier calls another promoted
# function through the LINKER, not through the guest's address space and
# not through bind.cpp's entry patch. Binding `play=src` therefore silently
# switches EVERY promoted callee of play() to its src form as well, whether
# or not that callee has a row in the bindfile.
#
# So "play=original vs play=src" is only an isolating experiment if the
# CALLEES are src on BOTH sides. These two files make that true:
#
#   all_rows_src_no_play.bindfile  every bind_table.inc row EXCEPT play
#   all_rows_src.bindfile          every bind_table.inc row, play included
#
# The only difference between a run of the first and a run of the second is
# the body of play() itself. Regenerate either by re-running the two-line
# scan of bind_table.inc quoted in carrier/NOTES.md "Divergence 010".
add_combo=src
add_jump_sequence=src
blit_to_screen=src
handle_player_collision_old=src
