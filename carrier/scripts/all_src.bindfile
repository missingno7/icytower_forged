# all_src.bindfile - every row of the GENERATED binding table
# (carrier/gen/bind_table.inc, from carrier/gen/gen_bind_table.py) bound to
# its src/icytower form at once, via --bind-file.
#
# Supersedes all35_src.bindfile, which is kept unchanged so the milestone-12
# "all 35 bound at once" result in carrier/NOTES.md stays reproducible
# exactly as it was measured. The five rows below the rule are the ones the
# generated table added after that milestone (carrier/NOTES.md "binding
# table generated"): add_floor was DIFFERing in vivo until divergence 008
# (notes/living_record.md) fixed its rand() binding, which is why this file
# only becomes usable now.
#
# draw_buffer and start_reward (in-vivo verification pass, 2026-09-07):
# build_blockers.json's asset-seam LNK2019 blocker is resolved -
# carrier/build.cmd now compiles both with pf_lib_bindings.h/
# pf_asset_bindings.h force-included in addition to pf_bindings_src.h
# (carrier/gen/scan_src_defs.py --extra-fi, mechanical CALL-syntax scan),
# so both have a real src form linked into carrier.exe and are listed below.
#
# A concurrently-running pass (batch 8) added a further function
# (draw_scroller) to gen/bind_table.inc after this file's original 40+2
# rows were fixed; it is deliberately left OUT of this list (out of this
# pass's own scope - not verified here) rather than guessed into an
# all-bound run this pass did not test.
#
# Order follows bind_table.inc's own row order.
add_combo=src
add_jump_sequence=src
get_gamepad=src
is_up=src
is_down=src
is_left=src
is_right=src
is_fire=src
is_pause=src
is_enter=src
is_any=src
set_control=src
init_control=src
check_control_key=src
is_solid=src
jump_player=src
line_intersect=src
get_demo=src
get_controls=src
switchedFromProgram=src
switchedToProgram=src
clickedCloseButton=src
getFloorData=src
reset_map=src
get_level=src
new_rand=src
ok_to_play=src
reset_particles=src
update_particle=src
create_particle=src
scroll_scroller=src
restart_scroller=src
cycle_counter=src
fps_counter=src
update_frame=src
# --- added by the generated binding table (post-milestone-12) ---
handle_player_collision_original=src
add_floor=src
play_jump_sound=src
reset_player=src
update_player=src
# --- added by this in-vivo verification pass (asset-seam unblocked) ---
draw_buffer=src
start_reward=src
# --- added by batch 9's in-vivo pass, corpus gates, asset oracle pass
#     (2026-09-07): collision.c's four collision_type=1/3/4/(dead-code-2-
#     is-handled-by-handle_player_collision_original-above) variants, now
#     compiled and bound. collision_type is a compile-time constant 2
#     (handle_player_collision_vector's own dispatch case), so only
#     _vector is ever selected in vivo by any recording; the other three
#     are included here for completeness of the all-bound run (0
#     invocations expected, same treatment as handle_player_collision_
#     original above) rather than left out. ---
handle_player_collision_old=src
handle_player_collision_vector=src
handle_player_collision_vector_2=src
handle_player_collision_combo=src
# --- added by this in-vivo pass (batch 11 generator-gap fix, 2026-09-08):
# poll_control/handle_player_input/blit_to_screen (PROMOTIONS.md batch 11)
# were link-blocked until _cos_tbl (an Allegro data table blit_to_screen's
# own transcribed fixsin() needs) gained a binding -- see carrier/NOTES.md
# "in-vivo pass, library globals referenced by clean code". Verified
# EQUAL (per-invocation, per-tick digest, and the frame oracle for
# blit_to_screen/handle_player_input) over all three scripted workloads
# before being added here. draw_frame/draw_scroller (batches 8/10, verified
# in vivo by a concurrently-running pass) are deliberately left OUT of this
# list, same discipline as the comment above for draw_scroller -- not this
# pass's own rows to add. ---
poll_control=src
handle_player_input=src
blit_to_screen=src
# --- play(): added by batch 12, and RESOLVED by the divergence-010 pass
# (2026-09-08). Batch 12 added this row with a loud "KNOWN, MEASURED,
# REPRODUCIBLE DIVERGENCE" caveat: human_test.txt finished score=662
# floor=50 instead of the witness score=2386 floor=100, and
# --digest-out/--stop-at-tick produced NOTHING for any run with play
# bound. Both are fixed and the caveat is retired:
#
# 1. The tick safepoint was VA 0x4124f4, an address INSIDE play()'s own
#    machine code. It is now a FUNCTION-BOUNDARY sensor at update_player's
#    entry, resolved per run to whichever of its two entry addresses the
#    run can reach (carrier/win32_policy.hpp kTickSafepoint,
#    carrier/src/det.cpp resolve_tick_safepoint). The frame oracle had the
#    same defect and got the same treatment (carrier/src/frame.cpp).
#    Baseline consequence: replays/human_test.digest and
#    replays/itr_last_game.digest were regenerated from unbound runs,
#    because the new safepoint hashes the same 151 globals at a different
#    point of the same tick (main.c 3703 rather than 4369).
#
# 2. The score/floor divergence was one character of play.c: main.c 3864,
#    `level = (get_level(&map, (int)ply[player_id]->y) - 1) / 10` where
#    the original divides by 5 (0x412885 is `sar %edx`, a ONE-bit shift of
#    the 0x66666667 magic-divide, not the `sar $0x2` that would make it
#    /10). Every floor the player reached was reported as half of itself.
#    Fixed; human_test.txt now finishes score=2386 floor=100 with the
#    per-tick digest and the frame oracle both EQUAL for all 2293 ticks.
#
# NOTE (divergence 010, and the reason this file is NOT the isolating
# instrument for play): pf_bindings_src.h leaves a promoted name free, so
# a bound src play() calls the src form of EVERY promoted callee through
# the linker whether or not that callee has a row here. Use
# scripts/all_rows_src_no_play.bindfile / all_rows_src.bindfile when the
# question is "what does play()'s own body change".
play=src
