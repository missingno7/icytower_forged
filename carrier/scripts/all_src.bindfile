# .itr's one host-audio-nondeterministic column). Landing them needed the
# carrier fix divergence 011 is named for: malloc/calloc/realloc/free, time,
# clock and the stdio family now reach the GUEST's IAT slots from src/.
# Batch 15's create_replay/load_replay rows are NOT here -- that pass's own
# functions, still in flight while this one measured. ---
qualify_hisc_table=src
sort_hisc_table=src
enter_hisc_table=src
get_rank=src
get_rank_id=src
save_profile=src
hash=src
calc_replay_checksum_131=src
calc_replay_checksum=src
